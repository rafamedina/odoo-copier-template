# Copy to .env and adjust. docker compose reads .env automatically.

# Compose project name (prefix for containers and volumes)
PROJECT_NAME={{project_slug}}

# Pin a dated tag (e.g. 18.0-20260901) for reproducible builds
ODOO_VERSION={{odoo_version}}
POSTGRES_VERSION=16

# Database created/used by the dev container
ODOO_DB={{ project_slug | replace('-', '_') }}

# Comma-separated addons to install and update on every start
ODOO_MODULES={{ module_name if create_module else 'base' }}

# Tests: one "/<module>" per addon, comma-separated
ODOO_TEST_TAGS=/{{ module_name if create_module else 'base' }}

ODOO_LANG=es_ES
ODOO_PORT=8069
DB_PORT=5433
